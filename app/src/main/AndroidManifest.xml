<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.oplus.wallpapers" />
        <package android:name="com.android.camera" />
        <package android:name="com.oplus.camera" />
        <package android:name="com.android.contacts" />
        <package android:name="com.android.dialer" />
        <package android:name="com.android.chrome" />
        <package android:name="com.android.gallery3d" />
        <package android:name="com.coloros.calculator" />
        <package android:name="com.heytap.music" />
        <package android:name="com.android.calendar" />
        <package android:name="com.coloros.calendar" />
        <package android:name="com.coloros.alarmclock" />
        <package android:name="com.coloros.filemanager" />
        <package android:name="com.coloros.soundrecorder" />
        <package android:name="com.coloros.gallery3d" />
        <package android:name="com.coloros.weather2" />
        <package android:name="com.android.calculator2" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.google.android.GoogleCamera" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.google.android.calendar" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.service.wallpaper.WallpaperService" />
        </intent>
        <package android:name="com.android.launcher" />
        <package android:name="com.oppo.launcher" />
        <package android:name="com.oplus.launcher" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/ui_module_description"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LauncherGlass">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".util.BootRestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".util.LauncherRestartReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/log_paths" />
        </provider>

        <provider
            android:name=".ui.SettingsProvider"
            android:authorities="com.cosmod.launcherglass.settings"
            android:exported="true"
            android:multiprocess="false" />

    </application>

</manifest>
